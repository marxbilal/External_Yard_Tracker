# Copy this file to ".env" and fill it in. Used only by: node scripts/setup-supabase.mjs
# Never commit or share ".env" - it holds the database password.

# Supabase -> Connect -> Direct -> method "Transaction pooler" (port 6543). Replace [YOUR-PASSWORD] (no brackets).
DATABASE_URL=postgresql://postgres.PROJECTREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# The project's address and its PUBLISHABLE key (sb_publishable_...). Never the secret key.
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_KEY=

# Optional: when moving from another Supabase project, that project's connection string.
# OLD_DATABASE_URL=
