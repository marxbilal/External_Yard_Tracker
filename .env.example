# Copy this file to ".env" and paste your Supabase connection string.
# Supabase dashboard -> Connect -> "Transaction pooler" (port 6543). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.PROJECTREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional: time zone used for "days in yard" (default Asia/Dubai)
# APP_TZ=Asia/Dubai
